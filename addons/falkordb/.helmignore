# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Tests live next to the chart but are not part of it. Helm stores the whole
# chart in its release Secret, capped at 1 MiB, and the e2e suite alone is
# large enough to push a release past that.
e2e/
scripts-ut-spec/
